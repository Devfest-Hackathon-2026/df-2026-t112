# api
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview   (遅い・失敗するときは gemini-flash-lite-latest や gemini-3.6-flash に変える)
# QUIZ_PROFILE=standard          (問題数の固定。mini: 6問 / standard: 12問 / full: 18問。未指定ならリポジトリの規模で 4〜18問)
# MISTAKE_REVIEW_PER_HOUR=60     (間違えた問題の復習の、1 人あたりの採点の回数)
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite   (1日の無料枠が切れたとき、この順に別モデルを試す。空文字で無効)
# GEMINI_THINKING_LEVEL=low       (minimal / low / medium / high / default)
GITHUB_TOKEN=
PORT=8080
# STORE=firestore   (未指定ならメモリ)
# ANSWER_SAVE_PER_HOUR=1200   (回答の保存の回数制限。1 人 1 時間あたり)
# AUTH=firebase     (Firebase ID token を検証し、ログインした人だけに使わせる。未指定か dev なら、全員を開発用のユーザーとして扱う。Cloud Run では firebase が必須)
# ALLOWED_GITHUB_IDS=12345 67890   (AUTH=firebase のとき、使ってよい人の GitHub の数字の ID。スペース区切り。* なら全員。空なら誰も使えない)
#                                  (ID の調べ方: gh api users/<ユーザー名> --jq .id)
# PRIVATE_REPOS=on   (ログインした人の非公開リポジトリも読む。未指定なら読まない。Gemini を有料枠にするまでは付けない。#34 の D26)

# web (web/.env.local) - 未設定ならログインせずに開発用のユーザーとして使う(API も AUTH=dev のとき)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# VITE_GITHUB_APP_SLUG=evc-escape-vibecoder   (GitHub App の URL の名前。非公開リポジトリが読めないときに、インストールの案内を出す)
