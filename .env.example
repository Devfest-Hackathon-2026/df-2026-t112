# api
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   (モデルが古くなったらここで差し替える)
# QUIZ_PROFILE=full               (既定は mini: 6 問・コード約2万文字。full は 18 問で遅い)
# GEMINI_THINKING_LEVEL=low       (minimal / low / medium / high / default)
GITHUB_TOKEN=
PORT=8080
# STORE=firestore   (未指定ならメモリ)
# AUTH=firebase     (Firebase ID token を検証する)

# web (web/.env.local) - 未設定ならログイン機能は表示されない
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
